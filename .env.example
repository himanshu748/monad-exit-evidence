# Copy to .env for local runs. Never commit real values.
# All variables are optional; an unconfigured checkout uses the local HyperIndex snapshot path.

# Envio data source for /api/activity: "hypersync" (hosted, what production uses) or "hyperindex" (local SQL snapshot, default)
ENVIO_DATA_SOURCE=hypersync
# Free personal HyperSync API token from https://envio.dev/app/api-tokens (server-side only, never expose to the browser)
ENVIO_API_TOKEN=

# Optional: HTTPS origin of a bridge serving /api/indexer-snapshot (only for the legacy hyperindex + bridge setup)
ENVIO_SNAPSHOT_ORIGIN=
# Set to 1 on the bridge host only, to serve /api/indexer-snapshot
SERVE_ENVIO_SNAPSHOT=
ENVIO_BRIDGE_ONLY=

# Public deployment hardening: enable per-client read limits and allow this exact origin
PUBLIC_DEMO=
PUBLIC_ORIGIN=

# Local server port (default 4100)
PORT=4100

# Where verifier/browser scripts write new proof files (must already exist)
EVIDENCE_DIR=
